<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="1200" height="800">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0094F0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0A2E18;stop-opacity:1" />
    </linearGradient>
    <pattern id="p" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
      <rect x="10" y="10" width="30" height="30" fill="rgba(255,255,255,0.04)" transform="rotate(45 25 25)"/>
    </pattern>
  </defs>
  <rect width="1200" height="800" fill="url(#g)"/>
  <rect width="1200" height="800" fill="url(#p)"/>
  <rect x="40" y="40" width="1120" height="720" rx="16" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" stroke-dasharray="8,6"/>
  <circle cx="600" cy="340" r="80" fill="rgba(255,255,255,0.08)"/>
  <circle cx="600" cy="340" r="55" fill="rgba(255,255,255,0.10)"/>
  <text x="600" y="348" font-family="Georgia, serif" font-size="42" fill="rgba(255,255,255,0.6)" text-anchor="middle" dominant-baseline="middle">📷</text>
  <text x="600" y="460" font-family="Georgia, serif" font-size="22" font-weight="bold" fill="rgba(255,255,255,0.85)" text-anchor="middle">Paiement Mobile Money</text>
  <text x="600" y="492" font-family="Arial, sans-serif" font-size="13" fill="rgba(255,255,255,0.45)" text-anchor="middle">Remplacer par votre photo dans public/images/</text>
  <text x="600" y="512" font-family="Arial, sans-serif" font-size="11" fill="rgba(255,255,255,0.3)" text-anchor="middle">blog-mobile-money.jpg</text>
</svg>
